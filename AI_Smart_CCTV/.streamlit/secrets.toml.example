# Copy this file to .streamlit/secrets.toml and fill it with your provider values.
# Never commit the real secrets.toml file.
# Set to "true" in Streamlit Community Cloud. It hides server-side live camera
# controls while retaining browser camera input on the Person detection page.
CCTV_HOSTED_DEPLOYMENT = "true"

[auth]
redirect_uri = "http://streamlit.app"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "your-oidc-client-id"
client_secret = "your-oidc-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
